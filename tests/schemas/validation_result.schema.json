{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationResult",
  "description": "Canonical Schema for Factory Step 5 Self-Validation Results (v1.0)",
  "type": "object",
  "required": [
    "schema_version",
    "validation_id",
    "validator",
    "executed_at",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "validation_id": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": ["checks_total", "passed", "failed", "warnings", "unverified"],
      "properties": {
        "checks_total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "category", "name", "status", "evidence", "details"],
        "properties": {
          "check_id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "structure",
              "agents",
              "skills",
              "references",
              "commands",
              "state",
              "contracts",
              "ownership",
              "safety",
              "packaging"
            ]
          },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "WARNING", "UNVERIFIED"]
          },
          "evidence": { "type": "string" },
          "details": { "type": "string" },
          "affected_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}
